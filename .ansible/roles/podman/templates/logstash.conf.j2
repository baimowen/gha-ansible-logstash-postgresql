input {
  beats { port => 5044 }
}

filter {
}

output {
  {% if logstash_stdout_output %}
    stdout { codec => rubydebug }
  {% endif %}

  # output1
  elasticsearch {
    hosts => ["http://{{ elasticsearch_container_name }}:9200"]
    index => "{{ logstash_es_index }}"
    user => "{{ elasticsearch_user }}"
    password => "${ELASTIC_PASSWORD}"
    ssl_verification_mode => "none"
    ilm_enabled => false
  }
}
