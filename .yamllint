---
extends: default

# ansible-lint 要求以下规则保持特定配置（见 lint/rules/yaml 文档）
rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false", "on"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  indentation:
    spaces: consistent
    indent-sequences: true

ignore: |
  .git/
  .venv/
  .ansible/collections/
  .ansible/roles/ansible-community.ansible-vault/
